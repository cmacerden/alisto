PORT=3000
DATABASE_PATH=./data/alisto.sqlite
# Set a random secret of at least 32 characters for deployment.
# Development automatically creates a persistent secret in data/session-secret.
SESSION_SECRET=
NODE_ENV=development
# Set to 1 only when deployed behind one trusted reverse proxy.
TRUST_PROXY=0

# Optional report email. Leave ALL SMTP fields empty for Ethereal preview only
# (requires internet; does not deliver to real inboxes).
SMTP_HOST=
SMTP_PORT=
# true for implicit TLS (usually port 465); false for required STARTTLS (587).
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
